{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "平台守门人重大事项与整改报告服务样例",
  "type": "object",
  "required": ["domain", "version", "events", "reports", "signals"],
  "properties": {
    "domain": {
      "type": "string",
      "const": "platform-gatekeeper-reporting"
    },
    "version": {
      "type": "integer",
      "minimum": 2
    },
    "as_of": {
      "type": "string"
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_kind",
          "monitor",
          "rule_code",
          "title",
          "observed_at",
          "teams",
          "confidence",
          "status",
          "linked_report_ids"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source_kind": { "const": "monitor_signal" },
          "monitor": { "type": "string", "minLength": 1 },
          "rule_code": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" },
          "observed_at": { "type": "string" },
          "teams": { "type": "array", "items": { "type": "string" } },
          "confidence": { "enum": ["low", "medium", "high"] },
          "status": { "enum": ["new", "converted", "dismissed"] },
          "linked_report_ids": { "type": "array", "items": { "type": "string" } },
          "suspected_event_id": { "type": ["string", "null"] },
          "disposition": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "team",
          "title",
          "observed_at",
          "by",
          "source",
          "signal_ids",
          "status"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "team": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "observed_at": { "type": "string" },
          "created_at": { "type": "string" },
          "by": { "type": "string" },
          "source": { "enum": ["manual", "lead_confirmed"] },
          "signal_ids": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["new", "merged"] },
          "merged_event_id": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "level",
          "gatekeeper_domains",
          "status",
          "first_observed_at",
          "filed_at",
          "filing_deadline",
          "filing_timeliness",
          "teams",
          "reports",
          "snapshot",
          "snapshot_corrections",
          "tasks",
          "evidence",
          "commitments",
          "recurrence",
          "history"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "level": { "enum": ["major", "large", "ordinary"] },
          "gatekeeper_domains": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["数据", "算法", "流量", "规则"] }
          },
          "status": {
            "enum": ["reported", "investigating", "remediating", "closed"]
          },
          "first_observed_at": { "type": "string" },
          "filed_at": { "type": "string" },
          "filing_deadline": { "type": "string" },
          "filing_timeliness": { "enum": ["on_time", "late"] },
          "filed_by": { "type": "string" },
          "teams": { "type": "array", "items": { "type": "string" } },
          "reports": { "type": "array", "items": { "type": "string" } },
          "snapshot": {
            "type": ["object", "null"],
            "properties": {
              "window_start": { "type": "string" },
              "window_end": { "type": "string" },
              "rule_versions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["code", "version"],
                  "properties": {
                    "code": { "type": "string" },
                    "version": { "type": "string" },
                    "note": { "type": "string" }
                  }
                }
              },
              "affected_subjects": { "type": "array" },
              "interim_measures": { "type": "array" },
              "frozen_by": { "type": "string" },
              "frozen_at": { "type": "string" }
            }
          },
          "snapshot_corrections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["seq", "field", "before", "after", "reason", "by", "at"],
              "properties": {
                "seq": { "type": "integer", "minimum": 1 },
                "field": {
                  "enum": [
                    "window_start",
                    "window_end",
                    "rule_versions",
                    "affected_subjects",
                    "interim_measures"
                  ]
                },
                "before": {},
                "after": {},
                "reason": { "type": "string" },
                "by": { "type": "string" },
                "at": { "type": "string" }
              }
            }
          },
          "tasks": { "type": "array" },
          "evidence": { "type": "array" },
          "commitments": { "type": "array" },
          "recurrence": {
            "type": "object",
            "required": ["prior", "followups"],
            "properties": {
              "prior": { "type": "array" },
              "followups": { "type": "array" }
            }
          },
          "closed_at": { "type": ["string", "null"] },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["at", "by", "action", "detail"],
              "properties": {
                "at": { "type": "string" },
                "by": { "type": "string" },
                "action": { "type": "string" },
                "detail": { "type": "string" }
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
